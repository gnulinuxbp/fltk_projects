# data file for the Fltk User Interface Designer (fluid)
version 1.0311
i18n_type 1
i18n_include <libintl.h>
i18n_function gettext
header_name {.h}
code_name {.cxx}
decl {// (c) Robert Shingledecker 2008-2010} {private local
}

decl {\#include <cstdlib>} {private local
}

decl {\#include <iostream>} {private local
}

decl {\#include <locale.h>} {private local
}

decl {using namespace std;} {private local
}

Function {btn_callback( __attribute__ ((unused)) Fl_Widget* w, void* userdata)} {open return_type {static void}
} {
  code {system((const char*)userdata);} {}
}

Function {} {open
} {
  Fl_Window {} {
    label ControlPanel open
    xywh {480 127 440 135} type Double visible
  } {
    Fl_Tabs tabs {open
      xywh {5 5 430 125}
    } {
      Fl_Group maintenanceTab {
        label Maintenance open selected
        xywh {5 30 430 100}
      } {
        Fl_Button {} {
          label {Backup/Restore}
          user_data {"filetool &"}
          callback btn_callback
          xywh {30 45 120 30}
        }
        Fl_Button {} {
          label {Date/Time}
          user_data {"datetool &"}
          callback btn_callback
          xywh {160 45 120 30}
        }
        Fl_Button {} {
          label Network
          user_data {"sudo network &"}
          callback btn_callback
          xywh {290 45 120 30}
        }
        Fl_Button {} {
          label Services
          user_data {"services &"}
          callback btn_callback
          xywh {30 85 120 30}
        }
      }
      Fl_Group utilitiesTab {
        label Utilities open
        xywh {5 30 430 100} hide
      } {
        Fl_Button {} {
          label {Mount Tool}
          user_data {"mnttool &"}
          callback btn_callback
          xywh {30 45 120 30}
        }
        Fl_Button {} {
          label {Mouse Tool}
          user_data {"mousetool &"}
          callback btn_callback
          xywh {160 45 120 30}
        }
        Fl_Button {} {
          label {System Stats}
          user_data {"stats &"}
          callback btn_callback
          xywh {290 45 120 30}
        }
      }
      Fl_Group setupTab {
        label Setup open
        xywh {5 30 430 100} hide
      } {
        Fl_Button {} {
          label Wallpaper
          user_data {"pcmanfm --desktop-pref &"}
          callback btn_callback
          xywh {290 45 120 30}
        }
        Fl_Button {} {
          label Monitor
          user_data {"bprandr &"}
          callback btn_callback
          xywh {30 45 120 30}
        }
        Fl_Button {} {
          label Keyboard
          user_data {"tinykeyxorg &"}
          callback btn_callback
          xywh {160 45 120 30}
        }
        Fl_Button {} {
          label {Swapfile Tool}
          user_data {"swapfile &"}
          callback btn_callback
          xywh {30 85 120 30}
        }
        Fl_Button {} {
          label {Terminal Server}
          user_data {"xterm -bg black +tr +sb -T \\"Terminal Server Setup\\" -e sudo /usr/bin/tc-terminal-server &"}
          callback btn_callback
          xywh {160 85 120 30}
        }
      }
    }
  }
}
